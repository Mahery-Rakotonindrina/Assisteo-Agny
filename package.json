{
  "name": "assisteo-agny",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "next dev",
    "dev:lan": "node scripts/copy-wasm.mjs && next dev -H 0.0.0.0",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "next build",
    "build:mobile": "node scripts/copy-wasm.mjs && cross-env BUILD_TARGET=mobile next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build:mobile && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "db:migrate": "node scripts/db-migrate.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "examples": "node scripts/generate-examples.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:restore-check": "node scripts/db-restore-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-share-target": "^8.0.65",
    "@capgo/capacitor-speech-recognition": "^8.4.6",
    "@google/genai": "^2.32.0",
    "@ionic/pwa-elements": "^3.4.0",
    "@sentry/nextjs": "^11.11.0",
    "@supabase/supabase-js": "^2.119.0",
    "@upstash/redis": "^1.41.0",
    "exceljs": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.0",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "^6.2.7",
    "pg": "^8.23.1",
    "sass": "^1.108.0",
    "sharp": "^0.35.5",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "glob@>=9.0.0 <14.0.2": "14.0.3",
    "rimraf@>=5": {
      "glob": "14.0.3"
    },
    "minimatch@>=9.0.0 <11.0.1": "11.0.4",
    "uuid@<11.1.1": "11.1.1"
  }
}
