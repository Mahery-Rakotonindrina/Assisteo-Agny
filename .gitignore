# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# copied from node_modules at build time (scripts/copy-wasm.mjs)
/public/vendor/

# typescript
*.tsbuildinfo
next-env.d.ts

# Android signing keys: never commit (they live in GitHub secrets)
*.p12
*.jks
*.keystore

# Coding-agent skills installed by the skills CLI (not part of the app); the
# project's own assisteo-* skills are kept in the repository.
.agents/
.claude/skills/*
!.claude/skills/assisteo-*/
skills-lock.json
.claude/settings.local.json

# Playwright
/test-results/
/playwright-report/

# Firebase config (per developer / CI secret, see docs/push.md)
android/app/google-services.json
ios/App/App/GoogleService-Info.plist

# Database backups (encrypted, see docs/backups.md)
/backups/
*.agny
