# --- Server (web build: hosts /api/analyze) ---------------------------------
# AI engine: the first configured key wins (Claude, then Gemini).
# With no key at all, the app runs in demo mode (sample analyses).

# Claude (paid, best quality): https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5   # or claude-haiku-4-5 to keep costs down
# AI_EFFORT=medium                  # low | medium | high

# Gemini (free tier, no card): https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Optional overrides
# AI_PROVIDER=gemini      # force an engine: claude | gemini
# AI_DEMO_MODE=false      # force sample answers even with a key
# Extra origins allowed to call the API (comma-separated). Capacitor origins
# (capacitor://localhost, https://localhost, http://localhost) are always allowed.
# ALLOWED_ORIGINS=https://my-other-frontend.app

# --- Client ---------------------------------------------------------------
# Base URL of the deployed web build. Required for the mobile build (the
# static export has no API routes); leave empty on the web to use same origin.
NEXT_PUBLIC_API_URL=
