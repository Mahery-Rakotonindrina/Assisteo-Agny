# --- Server (web build: hosts /api/analyze) ---------------------------------
# AI engine: the first configured key wins (Claude, then Gemini).
# With no key at all, the app runs in demo mode (sample analyses).

# Claude (paid, best quality): https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5   # or claude-haiku-4-5 to keep costs down
# AI_EFFORT=medium                  # low | medium | high

# Gemini (free tier, no card): https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Free trial on the server's key before users must add their own key.
# TRIAL_SCANS=7            # default; change it at runtime from /admin
# TRIAL_SCANS_PER_IP=20
# ASK_PER_DAY=20
# All scans + questions on the server key per day, all users together (0 = no cap).
# SERVER_DAILY_LIMIT=200
# Upstash Redis (Vercel Marketplace) makes the trial count durable; without it
# counts live in memory and reset on cold starts.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Secret for the /admin page (edit the trial limits without redeploying).
# ADMIN_TOKEN=

# Optional overrides
# AI_PROVIDER=gemini      # force an engine: claude | gemini
# AI_DEMO_MODE=false      # force sample answers even with a key
# Extra origins allowed to call the API (comma-separated). Capacitor origins
# (capacitor://localhost, https://localhost, http://localhost) are always allowed.
# ALLOWED_ORIGINS=https://my-other-frontend.app

# Accounts & sync (Supabase, added by the Vercel integration)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# POSTGRES_URL_NON_POOLING=   # only for `npm run db:migrate`
# Encrypts users' own AI keys stored in their account (32 random bytes, base64)
# API_KEYS_SECRET=

# --- Client ---------------------------------------------------------------
# Base URL of the deployed web build. Required for the mobile build (the
# static export has no API routes); leave empty on the web to use same origin.
NEXT_PUBLIC_API_URL=

# Public Supabase settings (safe to expose: data is protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contact address shown on /privacy and /terms (required by the app stores).
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: protects /api/cron/keepalive (Vercel Cron sends it automatically).
CRON_SECRET=

# Defaults for the app version check (editable at runtime from /admin).
# APP_MIN_VERSION=        # installs below are blocked until they update
# APP_LATEST_VERSION=     # installs below see an "update available" banner
# APP_DOWNLOAD_URL=       # https link to the latest APK

# Error monitoring (optional): Sentry project DSN. The public one also enables
# client/app reporting; SENTRY_DSN alone only reports server errors.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# Reminder pushes (Android, Firebase Cloud Messaging): service account JSON,
# raw or base64. See docs/push.md. The app side needs NEXT_PUBLIC_PUSH_ENABLED
# (set by the APK workflow when google-services.json is provided).
# FIREBASE_SERVICE_ACCOUNT=
